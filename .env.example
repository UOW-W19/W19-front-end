# Copy this file to .env and fill in your values
# Only needed when running the frontend WITHOUT Docker (npm run dev)
# When running via Docker Compose, the API URL is baked in at build time

VITE_API_BASE_URL=http://localhost:8081/api
VITE_WS_URL=ws://localhost:8081/ws-native
VITE_GOOGLE_PLACES_KEY=your_google_places_api_key_here
VITE_MAPBOX_TOKEN=your_mapbox_public_token_here

# Set to false only when debugging service-worker caching locally.
VITE_ENABLE_PWA=true
